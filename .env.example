# ParaJudge 多智能体辩论裁决系统
# 当前版本：v0.3.0

# ============================================================
# LLM API Keys（必填：至少一个）
# ============================================================

# DashScope（通义千问）
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# 模型配置（可选）
# ============================================================

# 默认使用的模型
DEFAULT_PROVIDER=dashscope
DEFAULT_MODEL=qwen-max

# 辩论者温度（影响论点创造性）
DEBATER_TEMPERATURE=0.7

# 法官温度（影响法官间个体差异）
JUDGE_TEMPERATURE=0.5

# 审理温度（应较低以确保一致性）
REVIEW_TEMPERATURE=0.3

# ============================================================
# 系统配置
# ============================================================

# 默认辩论轮数
DEFAULT_ROUNDS=3

# 证据包默认大小
DEFAULT_MAX_PAPERS=20

# 是否启用 LLM 辅助审理
ENABLE_LLM_REVIEW=True

# 实验数据输出目录
EXPERIMENT_OUTPUT_DIR=./experiments

# ============================================================
# 版本信息（不要修改）
# ============================================================
PARAJUDGE_VERSION=0.3.0
